# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# NEXT_PUBLIC_* vars are baked into the bundle at build time
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_BADGE_TOKEN_ID
ARG NEXT_PUBLIC_DONATION_ACCOUNT_ID
ARG NEXT_PUBLIC_HEDERA_NETWORK
ARG NEXT_PUBLIC_USDC_TOKEN_ID
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_BADGE_TOKEN_ID=$NEXT_PUBLIC_BADGE_TOKEN_ID \
    NEXT_PUBLIC_DONATION_ACCOUNT_ID=$NEXT_PUBLIC_DONATION_ACCOUNT_ID \
    NEXT_PUBLIC_HEDERA_NETWORK=$NEXT_PUBLIC_HEDERA_NETWORK \
    NEXT_PUBLIC_USDC_TOKEN_ID=$NEXT_PUBLIC_USDC_TOKEN_ID \
    NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID

COPY package*.json turbo.json ./
COPY apps/web/package*.json ./apps/web/
COPY apps/worker/package*.json ./apps/worker/
COPY packages/db/package*.json ./packages/db/
COPY packages/shared/package*.json ./packages/shared/

RUN npm ci

COPY . .
RUN npx turbo build --filter=@taa/web

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/package.json ./apps/web/package.json
COPY --from=builder /app/packages/db ./packages/db
COPY --from=builder /app/packages/shared ./packages/shared

EXPOSE 3000
CMD ["npm", "run", "start", "--workspace=apps/web"]
